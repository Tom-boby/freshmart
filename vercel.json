{
  "version": 2,
  "builds": [
    {
      "src": "api/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "dist/grocery-shop/browser/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/server.js"
    },
    {
      "src": "/(.*\\.[a-zA-Z0-9]+)$",
      "dest": "/dist/grocery-shop/browser/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/grocery-shop/browser/index.html"
    }
  ]
}
